#!/bin/bash
# phbuild <worktree> <cmd...>  -- run a heavy web command (tsc, next lint/build, vitest, npm run check ...) on the PH VM, not on dev02.
#   phbuild ~/projects/website-city npx tsc --noEmit
#   phbuild ~/wt/foo npm run check          phbuild ~/wt/foo npx vitest run          phbuild ~/wt/foo npm run build
# Syncs the tree (excl. node_modules, .next*, .git, test artifacts) to ph-tmc-dev:~core/pb/<name>/, restores node_modules from a
# per-lockfile-hash cache (seeded from the worktree's own node_modules on first use of a lockfile, then prisma generate), runs the command under PH's `heavy` lane with
# NODE_OPTIONS=--max-old-space-size=${PHBUILD_HEAP:-8192}, streams output, returns the exit code. Works as christian and as core (core has ~/.ssh/ph, authorized on PH core). node_modules symlinks are resolved.
# Lane: tsc/lint/check/vitest/test -> check (4 slots), anything else -> build (2 slots). Build output stays on PH (~core/pb/<name>/.next).
set -u
[ $# -ge 2 ] || { sed -n 2,9p "$0"; exit 2; }
wt=$(readlink -f "$1"); shift
[ -f "$wt/package.json" ] || { echo "phbuild: $wt has no package.json" >&2; exit 2; }
name=$(basename "$wt"); heap=${PHBUILD_HEAP:-8192}
case "$*" in *tsc*|*lint*|*check*|*vitest*|*"npm test"*|*"npm run test"*) lane=check;; *) lane=build;; esac
hash=$(sha256sum "$wt/package-lock.json" | cut -c1-16)
H=ph-tmc-dev
if [ "$(id -un)" = core ]; then SU=""; else SU="sudo -n -u core"; fi
RS="${SU:+$SU }rsync"
echo "phbuild: sync $name -> $H (lane $lane, heap ${heap}M)" >&2
ssh $H "$SU mkdir -p /home/core/pb" || exit 1
rsync -az --delete --rsync-path="$RS" \
  --exclude=/node_modules --exclude='/.next*' --exclude=/.git --exclude=/tests/.artifacts --exclude=/tests/.report --exclude='*.tsbuildinfo' --exclude='/.env.*' --exclude='*.pem' --exclude='*.key' --exclude=/certificates --exclude=/ssl \
  "$wt/" "$H:/home/core/pb/$name/" || exit 1
if ! ssh $H "test -d /home/core/pb/_nm/$hash/node_modules"; then
  [ -d "$wt/node_modules" ] || { echo "phbuild: no node_modules in $wt to seed the PH cache from (run npm ci there once; PH has no registry token)" >&2; exit 1; }
  echo "phbuild: seeding node_modules cache $hash from $wt (first use of this lockfile)" >&2
  ssh $H "$SU mkdir -p /home/core/pb/_nm/$hash" && \
  rsync -a --rsync-path="$RS" "$(readlink -f "$wt/node_modules")/" "$H:/home/core/pb/_nm/$hash/node_modules/" && \
  rsync -a --rsync-path="$RS" "$wt/package-lock.json" "$H:/home/core/pb/_nm/$hash/" || exit 1
fi
q=$(printf '%q ' "$@")
# PH has node 20, whose `node --test` does not expand globs (added in 21): `npm test` found no "src/**/*.test.ts".
# Run the package.json test script with its quoted globs replaced by a find list.
case "$*" in "npm test"|"npm run test")
  # shell-quoted: the remote bash re-reads $q as one command line
  q="node --import tsx --import ./scripts/sprite-test-loader.mjs --test \$(find src -name '*.test.ts' | sort)" ;;
esac
exec ssh $H "${SU:+$SU }bash -s" <<EOF
set -e
cd ~/pb/$name
if [ "\$(cat .nm-hash 2>/dev/null)" != "$hash" ] || [ ! -d node_modules ]; then
  rm -rf node_modules; cp -a ~/pb/_nm/$hash/node_modules node_modules; echo $hash > .nm-hash; rm -f .prisma-sum
fi
sum=\$(cat prisma/schema.prisma prisma/schema/*.prisma 2>/dev/null | sha256sum)
if [ -d prisma ] && [ "\$sum" != "\$(cat .prisma-sum 2>/dev/null)" ]; then npx prisma generate >&2 && echo "\$sum" > .prisma-sum; fi
# next-env.d.ts is generated by next dev/build and gitignored; without it the *.svg/*.webp module types are missing on a clean tree
[ -f next-env.d.ts ] || printf '/// <reference types="next" />\n/// <reference types="next/image-types/global" />\n' > next-env.d.ts
set +e
export NODE_OPTIONS=--max-old-space-size=$heap CI=1
heavy --lane $lane -- $q
EOF
