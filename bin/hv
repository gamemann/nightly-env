#!/usr/bin/env bash
# hv: run a suite or scene through `heavy` in the ONE form dot-bootstrap/tools/gpu.sh can offload to the staging
# boxes (cwd = a worktree directly under ~/wt or a checkout under ~/godot; `[timeout N] ./game.sh [--no-parse] test [suites]`
# or `[timeout N] godot --headless --path . res://x.tscn`; no bash -c wrapper, no GODOT=, no absolute --path, no
# GPU_/HEAVY_ env). Anything else queues behind dev02's 5 build slots and the boxes sit idle.
#
#   hv <worktree> game [--no-parse] test [suite...]      full or partial game suite, ONE job (suites in a row)
#   hv <worktree> shard [--no-parse] [--jobs N] [suite...]  the same, one job per suite on all free box slots at
#                                                         once, one merged report (use this for 2+ suites)
#   hv <worktree> scene res://examples/x.tscn [-- args]  one headless scene
#   hv <worktree> import                                  godot --headless --import (local: not offerable)
#   hv <worktree> local <command...>                      anything else, local lane (use rarely)
#   hv baseline <repo> [suite...]                         suites on origin/main, cached per commit (no suite = all)
# HV_TIMEOUT seconds (default 2400). Output goes to stdout/stderr: redirect it yourself (`> log 2>&1`).
# Run as the work user:  sudo -u gamedev /home/gamedev/bin/hv <worktree> ...
set -u
[ $# -ge 2 ] || { sed -n '2,15p' "$0"; exit 2; }

# hv baseline (2026-11-08): agents made their own *base* worktrees and ran the same suites on the same main commit
# again and again (4 worktrees at one commit; two headless_bots baselines at once on PH). This runs each suite once per
# origin/main commit in one shared worktree (~/wt/<repo>-baseline) and keeps the result in
# ~/.fleet/baseline/<repo>/<sha>/<suite>.{rc,log} (suite "all" = `game.sh test` with no names, parse pass included);
# failing.txt there lists the suites that failed on main. A second caller waits on the lock and reads the cache.
# HV_BASELINE_REFRESH=1 runs again even when cached. Exit 0 = every asked suite passes on main, 1 = some fail.
if [ "$1" = baseline ]; then
  repo=$2; shift 2
  main=/home/gamedev/godot/$repo
  [[ $repo =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] && git -C "$main" rev-parse --git-dir >/dev/null 2>&1 && [ -f "$main/game.sh" ] ||
    { echo "hv: baseline needs a game repo under /home/gamedev/godot (with game.sh): $repo" >&2; exit 2; }
  base=$HOME/.fleet/baseline; mkdir -p "$base"
  exec 8>>"$base/$repo.lock"
  flock 8
  if timeout 120 git -C "$main" fetch -q origin main 2>/dev/null; then sha=$(git -C "$main" rev-parse origin/main)
  else sha=$(git -C "$main" rev-parse --verify -q origin/main || git -C "$main" rev-parse main)
       echo "hv: WARNING could not fetch origin main; using the last known origin/main $sha" >&2; fi
  dir=$base/$repo/$sha; mkdir -p "$dir"
  wt=$HOME/wt/$repo-baseline
  [ $# -gt 0 ] || set -- all
  todo=()
  for s in "$@"; do
    [[ $s =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] || { echo "hv: bad suite name $s" >&2; exit 2; }
    [ "${HV_BASELINE_REFRESH:-0}" != 1 ] && [ -f "$dir/$s.rc" ] && continue
    todo+=("$s")
  done
  if [ ${#todo[@]} -gt 0 ]; then
    [ -d "$wt" ] || git -C "$main" worktree prune 2>/dev/null
    if [ ! -d "$wt" ]; then git -C "$main" worktree add -q --detach "$wt" "$sha" || { echo "hv: cannot make $wt" >&2; exit 2; }
    else git -C "$wt" checkout -q -f --detach "$sha" && git -C "$wt" reset -q --hard "$sha" || { echo "hv: cannot move $wt to $sha" >&2; exit 2; }; fi
    for s in "${todo[@]}"; do
      echo "hv: baseline $repo ${sha:0:9} $s: running (log $dir/$s.log)" >&2
      if [ "$s" = all ]; then "$0" "$wt" game test > "$dir/$s.log.tmp" 2>&1; else "$0" "$wt" game test "$s" > "$dir/$s.log.tmp" 2>&1; fi
      rc=$?
      mv -f "$dir/$s.log.tmp" "$dir/$s.log"
      # 124/137/143 = timeout or killed, 2/3 = hv usage or pre-flight: not a result, so not cached.
      case $rc in 2|3|124|137|143) echo "hv: baseline $s did not finish (exit $rc); not cached" >&2 ;; *) echo "$rc" > "$dir/$s.rc" ;; esac
    done
  fi
  bad=0
  for s in "$@"; do
    rc=$(cat "$dir/$s.rc" 2>/dev/null || echo none)
    printf 'baseline %s %s %s: %s  (%s)\n' "$repo" "${sha:0:9}" "$s" "$([ "$rc" = 0 ] && echo pass || echo "FAIL rc=$rc")" "$dir/$s.log"
    [ "$rc" = 0 ] || bad=1
  done
  for f in "$dir"/*.rc; do [ -f "$f" ] && [ "$(cat "$f")" != 0 ] && basename "$f" .rc; done > "$dir/failing.txt"
  exit $bad
fi
wt=$1; mode=$2; shift 2
cd "$wt" || { echo "hv: no such worktree $wt" >&2; exit 2; }
[ -f project.godot ] || [ "$mode" = local ] || { echo "hv: $wt has no project.godot (only 'hv <dir> local ...' works for non-Godot repos)" >&2; exit 2; }
export PATH=/home/gamedev/.local/bin:$PATH
case "$PWD" in
  /home/gamedev/wt/*/*) echo "hv: WARNING $PWD is nested: not offerable to the boxes (needs ~/wt/<name> directly)" >&2 ;;
esac
unset GODOT GPU_OFFLOAD
# 2026-11-08: dev02 (47GB, swapping) ran 5 suites locally and never queued, so PH (40c, mostly idle) and staging got no offers.
# Only 1 local build slot for hv jobs; the rest wait and are offered to PH/staging02/staging every 15 s. HEAVY_SLOTS_BUILD in env overrides.
export HEAVY_SLOTS_BUILD=${HEAVY_SLOTS_BUILD:-1}
t=${HV_TIMEOUT:-2400}

# Pre-flight (2026-11-07, v2 same day): a fresh/zombie worktree has only tracked files. It links what the project needs
# from /home/gamedev/godot/<repo>/addons/<addon> (repo = addon with _ -> -; fallbacks: the main checkout, then any
# ~/godot/*/addons/<addon>):
#   * addons named in .gitignore ('/addons/<n>' with or without trailing slash)
#   * addons referenced by res://addons/<n> in project.godot (plugins, autoloads) that are not present
#   * dangling symlinks left in addons/ (committed relative links that do not resolve from ~/wt)
#   * every addon symlink in the MAIN checkout's addons/ (what the repo itself needs; catches unlisted ones)
#   * transitively: each linked addon's source repo has its own addons/ links (dot-cloud -> dot_core ...): same rule
#   * '# bootstrap-link: <src>' content entries (any repo with a .gitignore; game.sh is NOT required: library repos
#     such as dot-map / dot-player-char / dot-radio have none, which is why v1 skipped them), plus an empty .stores
# Fails HERE (exit 3) if a hard need cannot be resolved. HV_NO_PREFLIGHT=1 skips it. Repos with no project.godot
# (dot-map-convert is Python) only support `hv <dir> local ...`.
hv_resolve() { # addon name -> prints source dir
  local n=$1 d r=${1//_/-}
  for d in "/home/gamedev/godot/$r/addons/$n" ${main:+"$main/addons/$n"} /home/gamedev/godot/*/addons/"$n" /home/gamedev/projects/godot/*/addons/"$n"; do
    [ -d "$d" ] && { readlink -f "$d"; return 0; }
  done
  return 1
}
hv_preflight() {
  [ -f .gitignore ] || [ -f project.godot ] || return 0
  local main common n t d path src missing="" queue=() i
  declare -A seen
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) && main=$(dirname "$common") || main=""
  [ "$main" = "$PWD" ] && main=""
  # hard needs
  [ -f .gitignore ] && while read -r n; do queue+=("$n"); done < <(sed -n 's|^/addons/\([A-Za-z0-9_]*\)/\{0,1\}[[:space:]]*$|\1|p' .gitignore)
  [ -f project.godot ] && while read -r n; do queue+=("$n"); done < <(grep -oE 'res://addons/[A-Za-z0-9_]+' project.godot | sed 's|res://addons/||' | sort -u)
  [ -d addons ] && while read -r d; do queue+=("${d##*/}"); done < <(find addons -maxdepth 1 -xtype l 2>/dev/null)
  if [ -n "$main" ] && [ -d "$main/addons" ]; then
    while read -r d; do queue+=("${d##*/}"); done < <(find "$main/addons" -maxdepth 1 -type l 2>/dev/null)
  fi
  i=0
  while [ $i -lt ${#queue[@]} ]; do
    n=${queue[$i]}; i=$((i+1))
    [ -n "${seen[$n]:-}" ] && continue; seen[$n]=1
    if [ ! -e "addons/$n" ]; then
      if t=$(hv_resolve "$n"); then
        mkdir -p addons && ln -sfn "$t" "addons/$n" && echo "hv: linked addons/$n -> $t" >&2
      else missing="$missing addons/$n"; continue; fi
    fi
    # transitive: the source repo's own addon links (<repo>/addons/<dep> next to addons/<n>)
    t=$(readlink -f "addons/$n" 2>/dev/null) || continue
    d=${t%/*}   # <repo>/addons
    [ -d "$d" ] && while read -r src; do queue+=("${src##*/}"); done < <(find "$d" -maxdepth 1 -type l 2>/dev/null)
  done
  [ -f .gitignore ] && while IFS=$'\t' read -r path src; do
    [ -n "$path" ] || continue; path=${path#/}; path=${path%/}
    [ -e "$path" ] && continue
    mkdir -p "$(dirname "$path")"
    if [ -n "$main" ] && [ -e "$main/$path" ]; then ln -sfn "$(readlink -f "$main/$path")" "$path" && echo "hv: linked $path" >&2
    elif [ "${path##*/}" = ".stores" ]; then mkdir -p "$path" && echo "hv: created empty $path (no art stores on this box; maps draw low-detail art)" >&2
    elif [ -e "/home/gamedev/godot/$src" ]; then ln -sfn "/home/gamedev/godot/$src" "$path" && echo "hv: linked $path -> ~/godot/$src" >&2
    else missing="$missing $path(from $src)"; fi
  done < <(awk '/^# bootstrap-link: /{src=$3; next} src!="" && /^\//{print $0 "\t" src} {src=""}' .gitignore)
  if [ -n "$missing" ]; then
    echo "hv: PRE-FLIGHT FAILED in $PWD: cannot resolve:$missing" >&2
    echo "hv: fix: tools/link_worktree.sh <main checkout> (if the repo has it) or link them by hand; nothing was submitted." >&2
    exit 3
  fi
}
# hv shard (2026-11-08): `hv game test a b c ...` is ONE heavy job, so its suites run one after another in one box slot
# while PH has 20 slots, staging02 8 and staging 7. `hv <wt> shard [--no-parse] [--jobs N] [suite...]` makes one heavy
# job per suite (`timeout T ./game.sh --no-parse test <suite>`, the offerable form), runs as many at once as the boxes
# have free slots (+1 for dev02; HV_SHARD_MAX caps it, default 16; --jobs N sets it), longest first (the last time per
# suite is kept in ~/.fleet/shard/<repo>.times; unknown suites go first), runs a suite again once when its job was
# killed or lost (exit 75/137/255) and merges it all into one report (pass/FAIL, box, seconds, peak MB/CPU, the
# suite's own check lines). No suite names = every suite (`./game.sh suites`) plus the parse pass (local check lane;
# --no-parse skips it), like `game.sh test`. T = max(HV_TIMEOUT, the suite's MIN_TIMEOUTS + 900, 1800).
# Output: ~/.fleet/shard/runs/<worktree>-<time>-<pid>/{report.txt,<suite>.out}. Exit 0 = all passed, 1 = a failure.
# hv_guard (2026-11-09): parse-error fast fail. A scene/suite with a broken script printed "SCRIPT ERROR: Parse Error" /
# "Failed to load script" and then idled until the 20 min watchdog (16 slot-hours/day). hv_guard runs the command with its
# output in a temp file (streamed to our stdout as it grows) and, when that file has such a line AND has not grown for
# HV_PARSE_QUIET seconds (default 180), kills the job's process tree and exits 66 with a message. Works for offloaded
# jobs too (their output comes back through the ssh). HV_NO_GUARD=1 disables. rc 66 = broken script, fix it and rerun.
hv_guard() {
  if [ "${HV_NO_GUARD:-0}" = 1 ]; then "$@"; return $?; fi
  local tmp pid tpid last=-1 lastt now sz q=${HV_PARSE_QUIET:-180} rc hit
  tmp=$(mktemp /tmp/hv-guard.XXXXXX) || { "$@"; return $?; }
  setsid "$@" >"$tmp" 2>&1 </dev/null & pid=$!
  tail -n +1 -f --pid=$pid "$tmp" 2>/dev/null & tpid=$!
  lastt=$(date +%s)
  while kill -0 "$pid" 2>/dev/null; do
    sleep 5
    now=$(date +%s); sz=$(stat -c %s "$tmp" 2>/dev/null || echo 0)
    if [ "$sz" != "$last" ]; then last=$sz; lastt=$now; continue; fi
    [ $((now - lastt)) -ge "$q" ] || continue
    hit=$(grep -m1 -E 'SCRIPT ERROR: (Parse|Compile) Error|Failed to load script|Parse Error:' "$tmp" 2>/dev/null) || continue
    kill -TERM -- "-$pid" $(hv_desc "$pid") 2>/dev/null; sleep 3; kill -KILL -- "-$pid" $(hv_desc "$pid") 2>/dev/null
    { echo "hv: BROKEN SCRIPT: the job logged a script parse/compile error and made no progress for ${q}s; killed it (exit 66)."
      echo "hv: first error line: ${hit:0:300}"
      echo "hv: fix the script (parse check: ./game.sh parse, or godot --headless --import) and run again."; } | tee -a "$tmp"
    kill "$tpid" 2>/dev/null; rm -f "$tmp"; return 66
  done
  wait "$pid"; rc=$?
  wait "$tpid" 2>/dev/null; rm -f "$tmp"; return $rc
}
hv_desc() { local c; for c in $(pgrep -P "$1" 2>/dev/null); do hv_desc "$c"; echo "$c"; done; }
hv_shard() {
  local noparse=0 jobs=${HV_SHARD_JOBS:-} suites=() s all=0
  while [ $# -gt 0 ]; do case $1 in
    --no-parse) noparse=1; shift ;;
    --jobs) jobs=${2:-}; shift 2 ;;
    --jobs=*) jobs=${1#*=}; shift ;;
    -*) echo "hv: shard: unknown option $1 (suite args after -- are not supported: use hv game for those)" >&2; exit 2 ;;
    *) suites+=("${1%.tscn}"); shift ;;
  esac; done
  if [ ${#suites[@]} -eq 0 ]; then all=1; mapfile -t suites < <(./game.sh suites 2>/dev/null); fi
  [ ${#suites[@]} -gt 0 ] || { echo "hv: shard: no suites (./game.sh suites printed none)" >&2; exit 2; }
  for s in "${suites[@]}"; do [[ $s =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] || { echo "hv: shard: bad suite name $s" >&2; exit 2; }; done
  local repo common
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) && repo=$(basename "$(dirname "$common")") || repo=$(basename "$PWD")
  local sd=$HOME/.fleet/shard run
  run=$sd/runs/$(basename "$PWD")-$(date +%Y%m%d-%H%M%S)-$$; mkdir -p "$run" || exit 2
  local times=$sd/$repo.times; touch "$times"
  declare -A tm; local a b
  while read -r a b; do [ -n "$a" ] && tm[$a]=$b; done < "$times"
  for s in "${suites[@]}"; do printf '%s %s\n' "${tm[$s]:-99999}" "$s"; done | sort -rn | awk '{print $2}' > "$run/queue"
  # How many at once: the free box slots now (+1 for dev02). Fewer leaves slots idle; more only parks extra waiters in
  # heavy's queue ahead of other agents' jobs.
  local gpu=${HEAVY_OFFLOAD:-} free
  [ -n "$gpu" ] || gpu=$(sed -n 's/^OFFLOAD=//p' /etc/heavy.conf 2>/dev/null | tail -1)
  [ -n "$gpu" ] || gpu=/home/gamedev/godot/dot-bootstrap/tools/gpu.sh
  free=$(timeout 90 "$gpu" capacity 2>/dev/null | grep -oE '^[a-z0-9]+ +[0-9]+/' | awk '{s+=$2} END{print s+0}')
  [[ $jobs =~ ^[0-9]+$ ]] && [ "$jobs" -gt 0 ] || jobs=$(( ${free:-0} + 1 ))
  [ "$jobs" -lt 2 ] && jobs=2
  [ "$jobs" -gt "${HV_SHARD_MAX:-16}" ] && jobs=${HV_SHARD_MAX:-16}
  [ "$jobs" -gt ${#suites[@]} ] && jobs=${#suites[@]}
  echo "hv: shard: ${#suites[@]} suite(s) over $jobs job(s) (${free:-?} free box slots now); output in $run" >&2
  local t0; t0=$(date +%s)
  trap 'trap - TERM INT HUP; echo "hv: shard: stopped; killing its jobs" >&2; kill $(hv_desc $$) 2>/dev/null; exit 143' TERM INT HUP
  if [ "$all" = 1 ] && [ "$noparse" = 0 ]; then
    ( heavy --lane check -- timeout 1800 bash -c 'GODOT=godot RED= GRN= OFF=
        timeout 600 "$GODOT" --headless --path . --import >/dev/null 2>&1
        eval "$(sed -n "/^PARSE_NOISE=/,/^}/p" game.sh)"
        parse_all; f=$?; [ "$f" = 0 ] && echo "  ok   every script parses"; exit "$f"' > "$run/_parse.out" 2>&1 </dev/null
      echo $? > "$run/_parse.rc" ) &
  fi
  local i
  for i in $(seq 1 "$jobs"); do
    (
      while :; do
        s=$( exec 9>>"$run/queue.lock"; flock 9; s=$(head -n 1 "$run/queue"); [ -n "$s" ] && sed -i 1d "$run/queue"; echo "$s" )
        [ -n "$s" ] || break
        mt=0
        for kv in $(sed -n 's/^MIN_TIMEOUTS="\(.*\)"/\1/p' game.sh); do [ "${kv%%=*}" = "$s" ] && mt=${kv#*=}; done
        T=$t; [ $((mt + 900)) -gt "$T" ] && T=$((mt + 900)); [ "$T" -lt 1800 ] && T=1800
        for try in 1 2; do
          st=$(date +%s)
          HV_SHARD=1 HEAVY_JOB_MAX_MIN=$((T / 60 + 5)) hv_guard heavy -- timeout "$T" ./game.sh --no-parse test "$s" > "$run/$s.out" 2>&1 </dev/null
          rc=$?; en=$(date +%s)
          if [ "$try" = 1 ]; then case $rc in 75|137|255)
            mv -f "$run/$s.out" "$run/$s.out.try1"; echo "hv: shard: $s exited $rc (killed/lost); running it again" >&2; continue ;; esac; fi
          break
        done
        box=$(sed -n 's/^heavy: .*(\([A-Za-z0-9_-]*\)) took this suite:.*/\1/p' "$run/$s.out" | tail -n 1); : "${box:=dev02}"
        echo "$rc" > "$run/$s.rc"; echo "$box $((en - st)) $T" > "$run/$s.meta"
        echo "hv: shard: $s $([ "$rc" = 0 ] && echo ok || echo "FAIL rc=$rc") on $box in $((en - st))s" >&2
        # Only real results (pass/fail, not timeouts or kills) teach the order.
        case $rc in 0|1) ( exec 9>>"$times.lock"; flock 9; { grep -v "^$s " "$times"; echo "$s $((en - st))"; } > "$times.new"; mv -f "$times.new" "$times" ) ;; esac
      done
    ) &
    sleep 1   # stagger the first offers a little (each one rsyncs the tree)
  done
  wait
  trap - TERM INT HUP
  local t1 bad=0 sum=0 rc box dur T stats
  t1=$(date +%s)
  {
    echo "== hv shard report: $PWD ($(git rev-parse --short HEAD 2>/dev/null)), ${#suites[@]} suite(s), $jobs at once"
    if [ -f "$run/_parse.rc" ]; then
      rc=$(cat "$run/_parse.rc"); echo "-- parse pass (dev02): $([ "$rc" = 0 ] && echo pass || echo "FAIL rc=$rc")"
      grep -E '^  (ok|FAIL)' -A3 "$run/_parse.out" | head -n 40
      [ "$rc" = 0 ] || { bad=1; echo "   output: $run/_parse.out"; }
    fi
  } > "$run/report.txt"
  for s in "${suites[@]}"; do
    rc=$(cat "$run/$s.rc" 2>/dev/null || echo none); box=?; dur=0; T=?
    [ -f "$run/$s.meta" ] && read -r box dur T < "$run/$s.meta"
    sum=$((sum + dur))
    stats=$(sed -n "s/^gpu.sh: $box \(peak_mb=.*\)/\1/p" "$run/$s.out" 2>/dev/null | tail -n 1)
    {
      printf -- '-- %s: %s  box=%s %ss%s\n' "$s" "$([ "$rc" = 0 ] && echo pass || echo "FAIL rc=$rc")" "$box" "$dur" "${stats:+  ($stats)}"
      [ "$rc" = 124 ] && echo "   timed out after ${T}s"
      awk '/^running the suites/{on=1; next} on && /^$/{exit} on' "$run/$s.out" 2>/dev/null
      [ "$rc" = 0 ] || echo "   output: $run/$s.out"
    } >> "$run/report.txt"
    [ "$rc" = 0 ] || bad=1
  done
  local wall=$((t1 - t0))
  { echo "== $([ $bad = 0 ] && echo 'all passed' || echo 'SOME FAILED'): wall ${wall}s, suite time ${sum}s (x$(awk -v a=$sum -v b=$wall 'BEGIN{printf "%.1f", (b > 0) ? a / b : 0}') in parallel)"
    echo "   report: $run/report.txt"; } >> "$run/report.txt"
  cat "$run/report.txt"
  exit $bad
}
case $mode in game|scene|import|shard) [ "${HV_NO_PREFLIGHT:-0}" = 1 ] || hv_preflight ;; esac
# A scene in a fresh worktree (no class cache yet) cannot resolve class_name scripts: Godot prints "Failed to load
# script" / "Parse Error" and then idles until the watchdog kills it 20 min later (43 such kills a day, 2026-11-08).
# Import first (heavy puts --import in the check lane, so it does not wait behind the build slot). HV_NO_IMPORT=1 skips.
if [ "$mode" = scene ] && [ "${HV_NO_IMPORT:-0}" != 1 ] && [ ! -f .godot/global_script_class_cache.cfg ]; then
  echo "hv: $PWD has no .godot/global_script_class_cache.cfg (fresh worktree): importing before the scene" >&2
  heavy -- timeout 1800 godot --headless --path . --import </dev/null >&2 || echo "hv: WARNING the import exited $?; running the scene anyway" >&2
fi
case $mode in
  game)   hv_guard heavy -- timeout "$t" ./game.sh "$@"; exit $? ;;
  shard)  hv_shard "$@" ;;
  scene)  hv_guard heavy -- timeout "$t" godot --headless --path . "$@"; exit $? ;;
  import) exec heavy -- timeout "$t" godot --headless --path . --import ;;
  local)  exec heavy -- "$@" ;;
  *) echo "hv: unknown mode $mode" >&2; exit 2 ;;
esac
